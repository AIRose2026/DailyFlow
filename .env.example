# Supabase (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Langdock (Judith agent) — used server-side only by /api/judith/prompt.
# Never prefix these with NEXT_PUBLIC_, they must stay off the client bundle.
LANGDOCK_API_KEY=your-langdock-api-key
LANGDOCK_JUDITH_AGENT_ID=your-judith-agent-id
LANGDOCK_API_BASE_URL=https://api.langdock.com

# ClickUp — used server-side only by /api/feedback (the in-app feedback
# button). Never prefix these with NEXT_PUBLIC_, they must stay off the
# client bundle.
# Personal API token: ClickUp → Avatar (unten links) → Settings → Apps.
# List ID: die Ziel-Liste in ClickUp öffnen, ID steht in der URL
# (app.clickup.com/.../v/li/<LIST_ID>).
CLICKUP_API_TOKEN=your-clickup-api-token
CLICKUP_LIST_ID=your-clickup-list-id
